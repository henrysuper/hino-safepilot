  "tdx": {
    "token_url": "https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token",
    "base_url": "https://tdx.transportdata.tw/api/basic",
    "max_match_distance_m": 40.0,
    "max_congestion": 1.0,
    "timeout_s": 60
  }
